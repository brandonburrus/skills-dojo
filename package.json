{
  "name": "skills-dojo",
  "version": "0.2.0",
  "description": "Toolkit for testing and evaluating AI agent skills",
  "author": "Brandon Burrus <brandon@burrus.io>",
  "license": "MIT",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "dojo": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/brandonburrus/skills-dojo#readme",
  "keywords": [
    "ai",
    "agent",
    "skills",
    "evaluation",
    "testing",
    "cli",
    "agentskills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandonburrus/skills-dojo.git"
  },
  "bugs": {
    "url": "https://github.com/brandonburrus/skills-dojo/issues"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --fix .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepublishOnly": "npm run check && npm run build",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.79",
    "@ai-sdk/openai": "^3.0.65",
    "@anthropic-ai/sandbox-runtime": "^0.0.49",
    "@anthropic-ai/sdk": "^0.92.0",
    "@github/copilot-sdk": "^1.0.0-beta.4",
    "ai": "^6.0.191",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "figlet": "^1.11.0",
    "figures": "^6.1.0",
    "listr2": "^10.2.1",
    "openai": "^6.35.0",
    "pino": "^10.3.1",
    "smol-toml": "^1.6.1",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "^25.6.0",
    "@types/pino": "^7.0.4",
    "@vitest/coverage-v8": "^4.1.4",
    "husky": "^9.1.7",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
